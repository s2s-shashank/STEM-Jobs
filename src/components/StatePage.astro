---
import { withBase } from '../lib/url';
import type { StateMeta } from '../data/states';
import { CATEGORIES } from '../data/states';
import Bars from './Bars.astro';
import StatTile from './StatTile.astro';
import Explain from './Explain.astro';
import {
  getStateData,
  formatDate,
  formatMoney,
  formatNumber,
  formatGrowth,
  formatMetro,
  byEmployment,
  byCategory,
} from '../lib/data';

interface Props {
  state: StateMeta;
}

const { state } = Astro.props;
const data = getStateData(state.code);
const has = Boolean(data);
const occ = data?.occupations ?? [];
const live = data?.live;
const priv = live?.private;

const topJobs = byEmployment(occ).slice(0, 8);
const topPay = [...occ]
  .filter((o) => o.employment >= 200)
  .sort((a, b) => b.meanWage - a.meanWage)
  .slice(0, 8);
const growing = [...occ]
  .filter((o) => typeof o.growth === 'number' && (o.growth ?? 0) > 0)
  .sort((a, b) => (b.growth ?? 0) - (a.growth ?? 0))
  .slice(0, 8);

const categoryGroups = byCategory(occ, CATEGORIES);
const fieldBars = categoryGroups
  .map((g) => ({
    label: g.category.label,
    value: g.employment,
    color: g.category.color,
  }))
  .sort((a, b) => b.value - a.value);

const metroBars = Object.entries(data?.metros ?? {})
  .map(([title, value]) => {
    const { name, shared } = formatMetro(title);
    return { label: name, value, shared };
  })
  .sort((a, b) => b.value - a.value)
  .slice(0, 6);

const totalEmployment = occ.reduce((s, o) => s + o.employment, 0);
const medianAll =
  occ.length > 0
    ? occ.map((o) => o.medianWage).sort((a, b) => a - b)[Math.floor(occ.length / 2)]
    : undefined;

const liveBars = live
  ? CATEGORIES.map((c) => ({
      label: c.label,
      value: live.byCategory[c.id] ?? 0,
      color: c.color,
    }))
      .filter((bar) => bar.value > 0)
      .sort((a, b) => b.value - a.value)
  : [];

const privateBars = priv
  ? CATEGORIES.map((c) => ({
      label: c.label,
      value: priv.byCategory[c.id] ?? 0,
      color: c.color,
    }))
      .filter((bar) => bar.value > 0)
      .sort((a, b) => b.value - a.value)
  : [];
const cityBars = (priv?.topLocations ?? []).slice(0, 6).map((c) => ({
  label: c.name.replace(/,\s*[A-Z]{2}$/, ''),
  value: c.count,
  color: state.color,
}));
const employerBars = (priv?.topEmployers ?? []).slice(0, 6).map((c) => ({
  label: c.name,
  value: c.count,
  color: 'var(--c-data)',
}));

const SOURCE_NOTES: Record<string, string> = {
  USAJOBS: 'Open federal jobs. You can apply for these today.',
  'NJ Civil Service':
    'Open New Jersey state and local government exams. Applying puts you on a hiring list.',
  StateJobsNY: 'Open New York State government jobs. You can apply for these today.',
  'Commonwealth Careers':
    'Open Pennsylvania state government jobs. You can apply for these today.',
  CareerOneStop:
    'Private-sector jobs, counted by searching for each STEM occupation. The same job can be counted twice, so this number is kept separate.',
};
---

<section class="state-hero" style={`--accent:${state.color}`}>
  <div class="wrap">
    <span class="hero__tag">
      <span aria-hidden="true">●</span> {state.abbr} STEM jobs
    </span>
    <h1>STEM jobs in {state.name}</h1>
    <p class="lede">{state.blurb}</p>
    {data && <p class="stamp">Numbers as of {formatDate(data.asOf)}</p>}
  </div>
</section>

{
  !has ? (
    <section class="section">
      <div class="wrap wrap--narrow">
        <h2>Data is on its way</h2>
        <p class="lede">
          We are still collecting {state.name} numbers. Check back soon - the
          live job board, salary charts and metro breakdowns will appear here.
        </p>
        <p>
          <a class="btn btn--primary" href={withBase('/sources')}>
            See what we collect and why
          </a>
        </p>
      </div>
    </section>
  ) : (
    <>
      <section class="section section--tight">
        <div class="wrap">
          <div class="grid grid--2">
            <StatTile
              accent
              value={formatNumber(totalEmployment)}
              label="people already work in STEM jobs here"
              note="From a survey of every employer in the state"
            />
            <StatTile
              value={formatNumber(priv?.total)}
              label="private-sector STEM job matches right now"
              note="Searched per job, so one job can be counted more than once"
            />
            <StatTile
              value={formatNumber(live?.total)}
              label="government STEM jobs open today"
              note="Federal, state and local"
            />
            <StatTile
              value={formatMoney(medianAll)}
              label="a typical STEM salary"
              note="What the person in the middle earns"
            />
          </div>
        </div>
      </section>

      <section class="section section--tight">
        <div class="wrap wrap--narrow">
          <div class="card start-card">
            <h2 class="card__title">How to read this page</h2>
            <p>
              There are three different numbers on this page, and they are
              counting different things. Knowing which is which is most of
              the work.
            </p>
            <ul class="start-list">
              <li>
                <strong>People who already work in STEM</strong> - a count of
                everyone on the payroll, from a survey of employers. It changes
                slowly, once a year.
              </li>
              <li>
                <strong>Job postings</strong> - openings advertised right now.
                A posting is one job. It might be filled next week.
              </li>
              <li>
                <strong>Government jobs</strong> - a smaller set of openings
                you can apply for directly, listed on official job boards.
              </li>
            </ul>
          </div>
        </div>
      </section>

      <section class="section section--alt">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">What kinds of STEM work?</span>
            <h2>Where people work</h2>
            <p class="lede">
              This is every person in {state.name} working in a STEM job, split
              into the seven fields we use.
            </p>
          </div>
          <div class="card">
            <Bars
              items={fieldBars}
              label={`People in STEM jobs in ${state.name}, by field`}
              suffix=" people"
            />
          </div>
        </div>
      </section>

      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Who's hiring right now</span>
            <h2>Private-sector STEM jobs in {state.name}</h2>
            <p class="lede">
              Job postings from CareerOneStop, the federal site that collects
              openings from thousands of private employers. We ask it about
              every STEM job we track, so these counts are exact for each
              occupation.
            </p>
          </div>
          {priv && priv.total > 0 ? (
            <>
              <div class="grid grid--2">
                <div class="card">
                  <h3 class="card__title">Postings by field</h3>
                  <Bars
                    items={privateBars}
                    label={`Private-sector STEM postings in ${state.name} by field`}
                    suffix=" posting"
                  />
                  <p class="source-note">
                    {formatNumber(priv.total)} job matches in the last 30 days,
                    within 50 miles of the state. We search once per job, so
                    one job can be counted more than once.
                  </p>
                </div>
                <div class="card">
                  <h3 class="card__title">Where they are hiring</h3>
                  <Bars
                    items={cityBars}
                    label={`Private-sector STEM postings in ${state.name} by city`}
                    suffix=" posting"
                  />
                </div>
              </div>
              {employerBars.length > 0 && (
                <div class="card top-employers">
                  <h3 class="card__title">Who is hiring the most</h3>
                  <Bars
                    items={employerBars}
                    label={`Top private-sector STEM employers in ${state.name}`}
                    suffix=" posting"
                  />
                </div>
              )}
            </>
          ) : (
            <div class="card">
              <p class="muted">Private-sector posting counts are not available right now.</p>
            </div>
          )}
        </div>
      </section>

      <section class="section section--alt">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Government jobs</span>
            <h2>Jobs you can apply for today</h2>
            <p class="lede">
              Federal, state and local openings - the kind you can apply for
              right now on an official website.
            </p>
          </div>
          <div class="split">
            <div class="card">
              <Bars
                items={liveBars}
                label={`Open government STEM jobs in ${state.name} by field`}
                suffix=" job"
              />
              <table class="sources-table">
                <caption class="sr-only">Where the open job counts come from</caption>
                <thead>
                  <tr>
                    <th scope="col">Source</th>
                    <th scope="col" class="num">Count</th>
                  </tr>
                </thead>
                <tbody>
                  {(live?.sources ?? [])
                    .filter((source) => source.kind !== 'search')
                    .map((source) => (
                      <tr>
                        <th scope="row">
                          <a href={source.url} rel="noopener">
                            {source.name}
                          </a>
                          <span class="source-note">{SOURCE_NOTES[source.name] ?? ''}</span>
                        </th>
                        <td class="num">{formatNumber(source.count)}</td>
                      </tr>
                    ))}
                </tbody>
              </table>
            </div>
            <div class="card">
              <h3 class="card__title">Some real examples</h3>
              <ul class="postings">
                {(live?.postings ?? []).slice(0, 8).map((p) => (
                  <li class="posting">
                    <a class="posting__title" href={p.url} rel="noopener">
                      {p.title}
                    </a>
                    <span class="posting__meta">
                      {p.employer}
                      {p.location ? ` · ${p.location}` : ''}
                      {p.salaryMin && p.salaryMax
                        ? ` · ${formatMoney(p.salaryMin)}–${formatMoney(p.salaryMax)}`
                        : ''}
                    </span>
                  </li>
                ))}
              </ul>
              {live?.postings.length === 0 && <p class="muted">No postings recorded yet.</p>}
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">The most common jobs</span>
            <h2>What most STEM workers actually do</h2>
            <p class="lede">
              Click any job to see what it involves, what it pays and how many
              openings there are right now.
            </p>
          </div>
          <div class="card">
            <Bars
              items={topJobs.map((o) => ({
                label: o.title,
                value: o.employment,
                href: `/careers/${o.soc}`,
              }))}
              label={`Biggest STEM jobs in ${state.name}`}
              suffix=" people"
            />
          </div>
        </div>
      </section>

      <section class="section section--alt">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">The money</span>
            <h2>Which jobs pay the most?</h2>
            <p class="lede">
              Average yearly pay for jobs with 200 or more workers in{' '}
              {state.name}.
            </p>
          </div>
          <div class="card">
            <Bars
              items={topPay.map((o) => ({
                label: o.title,
                value: o.meanWage,
                color: state.color,
                href: `/careers/${o.soc}`,
              }))}
              label={`Highest paying STEM jobs in ${state.name}`}
              format="currency"
            />
            <p class="source-note">
              Average pay is pulled up a little by the highest earners, so the
              <a href={withBase('/careers')}>career pages</a> show the middle
              salary too.
            </p>
          </div>
        </div>
      </section>

      {metroBars.length > 0 && (
        <section class="section">
          <div class="wrap">
            <div class="section-head">
              <span class="eyebrow">Where they work</span>
              <h2>Which cities have the most STEM jobs?</h2>
              <p class="lede">
                A metro area is a city plus everything around it that shares the
                same job market. Some of them cross state lines.
              </p>
            </div>
            <div class="card">
              <Bars
                items={metroBars.map((m) => ({
                  label: m.label,
                  value: m.value,
                  color: state.color,
                }))}
                label={`STEM employment by metro area in ${state.name}`}
                suffix=" people"
              />
              <ul class="metro-shared">
                {metroBars
                  .filter((m) => m.shared.length > 0)
                  .map((m) => (
                    <li>
                      <strong>{m.label}</strong> also covers {m.shared.join(', ')}
                    </li>
                  ))}
              </ul>
            </div>
          </div>
        </section>
      )}

      {growing.length > 0 && (
        <section class="section section--alt">
          <div class="wrap">
            <div class="section-head">
              <span class="eyebrow">What is growing</span>
              <h2>Which STEM jobs are on the way up?</h2>
              <p class="lede">
                How much each job is predicted to grow, nationwide, between 2025
                and 2035.
              </p>
            </div>
            <div class="card">
              <Bars
                items={growing.map((o) => ({
                  label: o.title,
                  value: o.growth ?? 0,
                  display: formatGrowth(o.growth),
                  color: 'var(--c-good)',
                }))}
                label={`Fastest growing STEM jobs for ${state.name}`}
                format="percent"
              />
              <p class="source-note">
                A prediction, not a promise. The Bureau of Labor Statistics
                publishes these every year.
              </p>
            </div>
          </div>
        </section>
      )}

      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Go deeper</span>
            <h2>Pick a field and see the jobs inside it</h2>
            <p class="lede">
              Every job, what it involves, and what it pays in {state.name}.
            </p>
          </div>
          <div class="grid grid--3">
            {categoryGroups.map((g) => (
              <article class="card card--flat" style={`--accent:${g.category.color}`}>
                <div class="cat__icon" aria-hidden="true">
                  {g.category.icon}
                </div>
                <h3 class="card__title">{g.category.label}</h3>
                <p class="muted">
                  {formatNumber(g.employment)} people work in this field in{' '}
                  {state.abbr}.
                </p>
                <ul class="career-links">
                  {g.occupations.slice(0, 6).map((o) => (
                    <li>
                      <a href={withBase(`/careers/${o.soc}`)}>{o.title}</a>
                      <span class="muted"> · {formatMoney(o.meanWage)}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>
    </>
  )
}

<style>
  .state-hero {
    background:
      radial-gradient(
        900px 380px at 12% -20%,
        color-mix(in srgb, var(--accent) 45%, transparent) 0%,
        transparent 62%
      ),
      var(--navy-900);
    color: #eaf0fb;
    padding-block: var(--space-2xl);
  }
  .state-hero h1 {
    color: #fff;
  }
  .state-hero .lede {
    color: #b9c8e0;
  }

  .start-card {
    border-left: 5px solid var(--accent);
  }
  .start-list {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--ink-700);
  }
  .start-list li + li {
    margin-top: 0.6rem;
  }

  .split {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    align-items: start;
  }

  .postings {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .posting {
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--paper-sunk);
  }
  .posting:last-child {
    border-bottom: 0;
  }
  .posting__title {
    display: block;
    font-weight: 700;
    text-decoration: none;
  }
  .posting__title:hover {
    text-decoration: underline;
  }
  .posting__meta {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-500);
  }

  .cat__icon {
    font-size: 1.75rem;
    line-height: 1;
    margin-bottom: var(--space-2xs);
  }

  .career-links {
    list-style: none;
    padding: 0;
    margin: var(--space-s) 0 0;
    font-size: var(--step--1);
  }
  .career-links li + li {
    margin-top: 0.3rem;
  }

  .sources-table {
    margin-top: var(--space-m);
    font-size: var(--step--1);
  }
  .sources-table thead th {
    padding: 0.4rem 0.6rem;
  }
  .sources-table th,
  .sources-table td {
    padding: 0.5rem 0.6rem;
  }
  .sources-table .source-note {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--step--1);
    color: var(--ink-500);
  }

  .top-employers {
    margin-top: var(--space-m);
  }

  .metro-shared {
    list-style: none;
    margin: var(--space-s) 0 0;
    padding: 0;
    font-size: var(--step--1);
    color: var(--ink-500);
  }
  .metro-shared li + li {
    margin-top: 0.25rem;
  }
</style>
