---
interface Props {
  value: string;
  label: string;
  note?: string;
  accent?: boolean;
}

const { value, label, note, accent = false } = Astro.props;
---

<div class:list={['stat', accent && 'stat--accent']}>
  <div class="stat__value">{value}</div>
  <div class="stat__label">{label}</div>
  {note && <div class="stat__note">{note}</div>}
</div>
