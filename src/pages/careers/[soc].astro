---
import Base from '../../layouts/Base.astro';
import Bars from '../../components/Bars.astro';
import PayTranslation from '../../components/PayTranslation.astro';
import { withBase } from '../../lib/url';
import { allStateData, formatMoney, formatNumber, formatDate, formatGrowth } from '../../lib/data';
import { CATEGORY_MAP, STATES } from '../../data/states';

export async function getStaticPaths() {
  const socs = new Set<string>();
  for (const state of allStateData()) {
    for (const o of state.occupations) socs.add(o.soc);
  }
  return [...socs].map((soc) => ({ params: { soc } }));
}

const { soc } = Astro.params;

const perState = STATES.map((s) => {
  const data = allStateData().find((d) => d.state === s.code);
  const occ = data?.occupations.find((o) => o.soc === soc);
  return { state: s, occ, data };
}).filter((r) => r.occ);

if (perState.length === 0) {
  return Astro.redirect('/careers');
}

const primary = perState[0].occ!;
const title = primary.title;
const category = CATEGORY_MAP[primary.category];
const blurb =
  primary.blurb ??
  `${title} is part of the ${category?.label ?? 'STEM'} field. Here is what the data says about this career in each state we track.`;
const education =
  primary.education ??
  'Most people in this field start with a two-year degree, a certificate or an apprenticeship, then move to a four-year degree once they are working.';
const bestPay = perState.reduce((best, row) =>
  (row.occ!.medianWage ?? 0) > (best.occ!.medianWage ?? 0) ? row : best,
);

// Live postings that look like this job, from the first state that has them.
const liveSamples = perState
  .flatMap((row) =>
    (row.data?.live.postings ?? [])
      .filter((p) => p.title.toLowerCase().includes(title.split(' ')[0].toLowerCase()))
      .map((p) => ({ ...p, state: row.state.short })),
  )
  .slice(0, 6);
---

<Base
  title={`${title}: jobs, pay and what to study`}
  description={`${title} in New Jersey, New York and Pennsylvania: how many people work in it, what it pays, and what to study to get started.`}
>
  <section class="hero">
    <div class="wrap">
      <span class="hero__tag">
        <span aria-hidden="true">{category?.icon ?? '⚗️'}</span> {category?.label ?? 'STEM'}
      </span>
      <h1>{title}</h1>
      <p class="lede">{blurb}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="table-wrap">
        <table>
          <caption class="sr-only">{title} in each state</caption>
          <thead>
            <tr>
              <th scope="col">State</th>
              <th scope="col" class="num">People working</th>
              <th scope="col" class="num">Median pay</th>
              <th scope="col" class="num">Average pay</th>
              <th scope="col" class="num">Starting pay</th>
              <th scope="col" class="num">Growth</th>
            </tr>
          </thead>
          <tbody>
            {
              perState.map(({ state, occ }) => (
                <tr>
                  <th scope="row">
                    <a href={withBase(`/${state.code}`)}>{state.name}</a>
                  </th>
                  <td class="num">{formatNumber(occ!.employment)}</td>
                  <td class="num">{formatMoney(occ!.medianWage)}</td>
                  <td class="num">{formatMoney(occ!.meanWage)}</td>
                  <td class="num">{formatMoney(occ!.entryWage)}</td>
                  <td class="num">{formatGrowth(occ!.growth)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="grid grid--2 two-col">
        <div>
          <h2>What that salary feels like</h2>
          <PayTranslation annual={bestPay.occ!.medianWage} label="a year" />
          <p class="source-note">
            Based on the median pay in {bestPay.state.name}. Before taxes, and
            it varies a lot with experience and where you live.
          </p>
        </div>
        <div>
          <h2>Median pay compared</h2>
          <div class="card">
            <Bars
              items={perState.map((row) => ({
                label: row.state.name,
                value: row.occ!.medianWage ?? 0,
                color: row.state.color,
              }))}
              label={`Median pay for ${title} in each state`}
              format="currency"
            />
          </div>
        </div>
      </div>

      <div class="grid grid--2 two-col">
        <article class="card card--flat">
          <h2 class="card__title">How to get started</h2>
          <p class="muted">{education}</p>
          <h3 class="card__title">Good questions to ask</h3>
          <ul class="muted">
            <li>Do I want to work with my hands, with data, or with people?</li>
            <li>Is there a local apprenticeship or certificate program?</li>
            <li>Which classes should I sign up for next year?</li>
            <li>Who is already working in this job near me - could I ask them?</li>
          </ul>
        </article>

        <article class="card card--flat">
          <h2 class="card__title">What the numbers mean</h2>
          <p class="muted">
            <strong>Starting pay</strong> is what a new graduate with no
            experience typically earns. <strong>Median pay</strong> is what the
            person in the middle of the pay range earns - usually a better
            target than the average, which can be pulled up by a few very high
            earners.
          </p>
          <p class="muted">
            <strong>Growth</strong> is the projected change in the number of
            jobs over the next decade, straight from the Bureau of Labor
            Statistics.
          </p>
          <p class="source-note">
            Data as of {formatDate(perState[0].data?.asOf)}. <a href={withBase('/sources')}>Sources</a>
          </p>
        </article>
      </div>

      {
        liveSamples.length > 0 && (
          <section class="live">
            <h2>Jobs like this, open right now</h2>
            <ul class="postings">
              {liveSamples.map((p) => (
                <li class="posting">
                  <a class="posting__title" href={p.url} rel="noopener">
                    {p.title}
                  </a>
                  <span class="posting__meta">
                    {p.employer}
                    {p.location ? ` · ${p.location}` : ''} · {p.state}
                    {p.salaryMin && p.salaryMax
                      ? ` · ${formatMoney(p.salaryMin)}–${formatMoney(p.salaryMax)}`
                      : ''}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </section>
</Base>

<style>
  .two-col {
    margin-top: var(--space-l);
    align-items: start;
  }
  .live {
    margin-top: var(--space-xl);
  }
  .postings {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .posting {
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--paper-sunk);
  }
  .posting:last-child {
    border-bottom: 0;
  }
  .posting__title {
    display: block;
    font-weight: 700;
    text-decoration: none;
  }
  .posting__title:hover {
    text-decoration: underline;
  }
  .posting__meta {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-500);
  }
</style>
