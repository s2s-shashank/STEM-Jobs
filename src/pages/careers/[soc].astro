---
import Base from '../../layouts/Base.astro';
import Bars from '../../components/Bars.astro';
import PayTranslation from '../../components/PayTranslation.astro';
import Explain from '../../components/Explain.astro';
import { withBase } from '../../lib/url';
import {
  allStateData,
  formatMoney,
  formatNumber,
  formatDate,
  formatGrowth,
} from '../../lib/data';
import { describe } from '../../lib/descriptions';
import { CATEGORY_MAP, STATES } from '../../data/states';

export async function getStaticPaths() {
  const socs = new Set<string>();
  for (const state of allStateData()) {
    for (const o of state.occupations) socs.add(o.soc);
  }
  return [...socs].map((soc) => ({ params: { soc } }));
}

const { soc } = Astro.params;

const perState = STATES.map((s) => {
  const data = allStateData().find((d) => d.state === s.code);
  const occ = data?.occupations.find((o) => o.soc === soc);
  return { state: s, occ, data };
}).filter((r) => r.occ);

if (perState.length === 0) {
  return Astro.redirect('/careers');
}

const primary = perState[0].occ!;
const title = primary.title;
const category = CATEGORY_MAP[primary.category];
const job = describe(soc, primary.category);
const bestPay = perState.reduce((best, row) =>
  (row.occ!.medianWage ?? 0) > (best.occ!.medianWage ?? 0) ? row : best,
);

// Private-sector postings for this exact occupation, per state.
const openings = perState.map((row) => ({
  state: row.state,
  count: row.data?.live.private?.occupationCounts?.[soc] ?? 0,
}));

// Where the people who already do this job work, in the biggest state.
const busiest = perState.reduce((best, row) =>
  (row.occ!.employment ?? 0) > (best.occ!.employment ?? 0) ? row : best,
);
---

<Base
  title={`${title}: what it's like, what it pays`}
  description={`${title} in New Jersey, New York and Pennsylvania: what the job involves, what it pays, how many openings there are, and what to study.`}
>
  <section class="hero">
    <div class="wrap">
      <span class="hero__tag">
        <span aria-hidden="true">{category?.icon ?? '⚗️'}</span> {category?.label ?? 'STEM'}
      </span>
      <h1>{title}</h1>
      <p class="lede">{job.what}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid--2 job-intro">
        <article class="card card--flat">
          <h2 class="card__title">A typical day</h2>
          <p class="muted">{job.day}</p>
        </article>
        <article class="card card--flat">
          <h2 class="card__title">What to study</h2>
          <p class="muted">{job.school}</p>
          <p class="source-note">
            {primary.education
              ? `Most people in this job have a ${primary.education.charAt(0).toLowerCase()}${primary.education.slice(1)}.`
              : 'Most paths start with a certificate, apprenticeship or two-year degree.'}
          </p>
        </article>
      </div>

      <h2 class="section-title">The numbers</h2>
      <div class="table-wrap">
        <table>
          <caption class="sr-only">{title} in each state</caption>
          <thead>
            <tr>
              <th scope="col">State</th>
              <th scope="col" class="num">People doing this job</th>
              <th scope="col" class="num">Middle pay</th>
              <th scope="col" class="num">Starting pay</th>
              <th scope="col" class="num">Jobs open now</th>
              <th scope="col" class="num">Is it growing?</th>
            </tr>
          </thead>
          <tbody>
            {
              perState.map(({ state, occ }) => (
                <tr>
                  <th scope="row">
                    <a href={withBase(`/${state.code}`)}>{state.name}</a>
                  </th>
                  <td class="num">{formatNumber(occ!.employment)}</td>
                  <td class="num">{formatMoney(occ!.medianWage)}</td>
                  <td class="num">{formatMoney(occ!.entryWage)}</td>
                  <td class="num">
                    {formatNumber(
                      openings.find((o) => o.state.code === state.code)?.count,
                    )}
                  </td>
                  <td class="num">{formatGrowth(occ!.growth)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="source-note table-note">
          <strong>Middle pay</strong> is what the person in the middle earns -
          half earn more, half earn less.
          <Explain
            label="?"
            text="The median is the middle salary. It is more useful than the average, because a few very high salaries can drag an average up and make a job look better than it is for most people."
          />
          <br />
          <strong>Jobs open now</strong> counts private-sector job postings for
          this exact job in the last 30 days, within 50 miles of the state.
          <Explain
            label="?"
            text="These come from CareerOneStop, the federal site that collects job postings from thousands of private employers. A posting is one opening - it does not mean the job will last forever."
          />
          <br />
          <strong>Is it growing?</strong> is the Bureau of Labor Statistics
          prediction for how many more jobs there will be by 2035.
        </p>
      </div>

      <div class="grid grid--2 two-col">
        <div>
          <h2 class="section-title">What that salary feels like</h2>
          <PayTranslation annual={bestPay.occ!.medianWage} label="a year" />
          <p class="source-note">
            Based on the middle pay in {bestPay.state.name}, before taxes. Real
            pay depends on experience, overtime and where you live.
          </p>
        </div>
        <div>
          <h2 class="section-title">Where the pay is highest</h2>
          <div class="card">
            <Bars
              items={perState.map((row) => ({
                label: row.state.name,
                value: row.occ!.medianWage ?? 0,
                color: row.state.color,
              }))}
              label={`Middle pay for ${title} in each state`}
              format="currency"
            />
          </div>
        </div>
      </div>

      <div class="grid grid--2 two-col">
        <article class="card card--flat">
          <h2 class="card__title">How many people already do this?</h2>
          <p class="muted">
            In {busiest.state.name}, about{' '}
            <strong>{formatNumber(busiest.occ!.employment)}</strong> people work
            as {title.toLowerCase()}. Across all three states, the job is done by
            roughly{' '}
            <strong>
              {formatNumber(
                perState.reduce((sum, row) => sum + (row.occ!.employment ?? 0), 0),
              )}
            </strong>{' '}
            people.
          </p>
        </article>

        <article class="card card--flat">
          <h2 class="card__title">Good questions to ask</h2>
          <ul class="muted">
            <li>Do I want to work with my hands, with data, or with people?</li>
            <li>Is there a local apprenticeship or certificate program?</li>
            <li>Which classes should I sign up for next year?</li>
            <li>Who is already working in this job near me - could I ask them?</li>
          </ul>
        </article>
      </div>

      <p class="source-note final-note">
        Data as of {formatDate(perState[0].data?.asOf)}. Employment and pay come
        from the Bureau of Labor Statistics. <a href={withBase('/sources')}>See all sources</a>
        · <a href={withBase('/glossary')}>New to these words? Read the glossary</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .job-intro {
    margin-bottom: var(--space-xl);
  }
  .section-title {
    font-size: var(--step-2);
    margin-bottom: var(--space-s);
  }
  .two-col {
    margin-top: var(--space-l);
    align-items: start;
  }
  .table-note {
    margin: 0;
    padding: 0.8rem 1rem;
    border-top: 1px solid var(--paper-sunk);
    line-height: 1.7;
  }
  .final-note {
    margin-top: var(--space-xl);
  }
</style>
