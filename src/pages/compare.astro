---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
import { STATES } from '../data/states';
import {
  getStateData,
  formatNumber,
  formatMoney,
  formatDate,
  allStateData,
} from '../lib/data';

const rows = STATES.map((s) => {
  const d = getStateData(s.code);
  const occ = d?.occupations ?? [];
  const total = occ.reduce((sum, o) => sum + o.employment, 0);
  const wages = occ.map((o) => o.medianWage).sort((a, b) => a - b);
  return {
    state: s,
    data: d,
    open: d?.live.total,
    privateOpen: d?.live.private?.total,
    employment: total,
    median: wages.length ? wages[Math.floor(wages.length / 2)] : undefined,
  };
});

const ready = rows.filter((r) => r.data);
---

<Base
  title="Compare New Jersey, New York and Pennsylvania"
  description="STEM job numbers side by side for New Jersey, New York and Pennsylvania: people working, jobs open, salaries and how to read them."
>
  <section class="hero">
    <div class="wrap">
      <span class="hero__tag"><span aria-hidden="true">●</span> Side by side</span>
      <h1>New Jersey vs New York vs Pennsylvania</h1>
      <p class="lede">
        The same questions, asked the same way, for all three states. Useful if
        you are deciding where to look for a first job.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {
        ready.length === 0 ? (
          <div class="wrap--narrow">
            <h2>Nothing to compare yet</h2>
            <p class="lede">The first data run is still in progress.</p>
          </div>
        ) : (
          <>
            <div class="table-wrap">
              <table>
                <caption class="sr-only">
                  STEM job statistics compared across New Jersey, New York and
                  Pennsylvania
                </caption>
                <thead>
                  <tr>
                    <th scope="col">What we measured</th>
                    {rows.map((r) => (
                      <th scope="col" class="num">
                        {r.state.short}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <th scope="row">People already working in STEM jobs</th>
                    {rows.map((r) => (
                      <td class="num">{formatNumber(r.employment)}</td>
                    ))}
                  </tr>
                  <tr>
                    <th scope="row">Private-sector job postings (30 days)</th>
                    {rows.map((r) => (
                      <td class="num">{formatNumber(r.privateOpen)}</td>
                    ))}
                  </tr>
                  <tr>
                    <th scope="row">Government jobs open today</th>
                    {rows.map((r) => (
                      <td class="num">{formatNumber(r.open)}</td>
                    ))}
                  </tr>
                  <tr>
                    <th scope="row">Typical STEM salary (middle pay)</th>
                    {rows.map((r) => (
                      <td class="num">{formatMoney(r.median)}</td>
                    ))}
                  </tr>
                  <tr>
                    <th scope="row">Data collected on</th>
                    {rows.map((r) => (
                      <td class="num small muted">{formatDate(r.data?.asOf)}</td>
                    ))}
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="source-note">
              The first two rows count different things, on purpose. The first
              is everyone on the payroll. The second is job openings advertised
              in the last month. You cannot compare them directly - and neither
              can the government.
            </p>
          </>
        )
      }
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Worth knowing</span>
        <h2>How to read these numbers</h2>
        <p class="lede">
          Three things that trip people up when they read jobs data.
        </p>
      </div>
      <div class="grid grid--3">
        <article class="card card--flat">
          <h3 class="card__title">An opening is not a career</h3>
          <p class="muted">
            A posting is one job opening today. It might be filled next week.
            It shows you that employers are hiring, not that a job is waiting
            for you.
          </p>
        </article>
        <article class="card card--flat">
          <h3 class="card__title">Middle beats average</h3>
          <p class="muted">
            A few very high salaries drag the average up. The middle salary is
            what the person in the middle earns - a much better guide to what
            you would actually get.
          </p>
        </article>
        <article class="card card--flat">
          <h3 class="card__title">STEM is not only university</h3>
          <p class="muted">
            Plenty of STEM careers - technicians, machinists, IT support,
            surveying - start with a certificate, an apprenticeship or a
            two-year degree.
          </p>
        </article>
      </div>
      <p class="source-note">
        Words you might not know? <a href={withBase('/glossary')}>The glossary explains them.</a>
      </p>
    </div>
  </section>
</Base>
