---
import Base from '../layouts/Base.astro';
import StatePage from '../components/StatePage.astro';
import { STATE_MAP } from '../data/states';

const state = STATE_MAP.ny;
---

<Base
  title="New York STEM jobs"
  description="How many STEM jobs are open in New York right now, what they pay, where the jobs are, and what to study to get one."
>
  <StatePage state={state} />
</Base>
