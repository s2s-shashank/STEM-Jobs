---
import { withBase } from '../lib/url';
import Base from '../layouts/Base.astro';
import StateCard from '../components/StateCard.astro';
import StatTile from '../components/StatTile.astro';
import Bars from '../components/Bars.astro';
import MyMatches from '../components/MyMatches.astro';
import { STATES } from '../data/states';
import {
  getStateData,
  formatNumber,
  formatMoney,
  lastUpdated,
  byEmployment,
} from '../lib/data';
import { CATEGORIES } from '../data/states';

const stateData = STATES.map((s) => {
  const d = getStateData(s.code);
  return {
    state: s,
    headline: d?.live.total ? `${formatNumber(d.live.total)} open STEM jobs` : undefined,
    headlineNote: d ? 'right now' : undefined,
    available: Boolean(d),
  };
});

const updated = lastUpdated();

// A few numbers to put on the front page.
const nj = getStateData('nj');
const allOccupations = nj?.occupations ?? [];
const totalStemWorkers = allOccupations.reduce((sum, o) => sum + o.employment, 0);
const openNow = STATES.reduce(
  (sum, s) => sum + (getStateData(s.code)?.live.private?.total ?? 0),
  0,
);
const bestPay = [...allOccupations]
  .filter((o) => o.employment >= 500)
  .sort((a, b) => b.meanWage - a.meanWage)[0];
const topJob = byEmployment(allOccupations)[0];
const biggestJob = byEmployment(allOccupations).filter((o) => o.employment > 5000)[0];
const fastestGrowing = [...allOccupations]
  .filter((o) => typeof o.growth === 'number')
  .sort((a, b) => (b.growth ?? 0) - (a.growth ?? 0))[0];
---

<Base
  title="STEM Jobs in New Jersey, New York and Pennsylvania"
  description="See how many STEM jobs are open right now, what they pay, and where the jobs are — real numbers for students in New Jersey, New York and Pennsylvania."
>
  <section class="hero">
    <div class="wrap">
      <span class="hero__tag">
        <span aria-hidden="true">●</span> Live data from official government sources
      </span>
      <h1>What does a STEM job actually look like where you live?</h1>
      <p class="lede">
        Real numbers about science, technology, engineering and maths jobs in
        New Jersey, New York and Pennsylvania. How many are open. What they
        pay. And what you would study to get one.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={withBase("/nj")}>Start with New Jersey</a>
        <a class="btn btn--ghost" href={withBase("/compare")}>Compare all three states</a>
        <button type="button" class="btn btn--sun" data-open-finder>
          Find my career
        </button>
      </div>
      {updated && <p class="stamp">Last updated {updated.slice(0, 10)}</p>}
    </div>
  </section>

  {
    totalStemWorkers > 0 && (
      <section class="section section--tight">
        <div class="wrap">
          <div class="grid grid--3">
            <StatTile
              accent
              value={formatNumber(totalStemWorkers)}
              label="people already work in STEM jobs in New Jersey"
              note="From a survey of every employer in the state"
            />
            <StatTile
              value={formatNumber(openNow)}
              label="private-sector STEM job postings right now"
              note="Across all three states, posted in the last 30 days"
            />
            <StatTile
              value={formatNumber(biggestJob?.employment)}
              label={`people work as ${biggestJob?.title ?? 'STEM workers'} in New Jersey`}
              note="That is the most common STEM job in the state"
            />
          </div>
        </div>
      </section>
    )
  }

  <MyMatches />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Pick your state</span>
        <h2>Where are the STEM jobs?</h2>
        <p class="lede">
          Every number here comes straight from a government agency, and each
          one is stamped with the date it was collected. Pick the state you
          live in.
        </p>
      </div>

      <div class="grid grid--3">
        {stateData.map((s) => <StateCard state={s.state} headline={s.headline} headlineNote={s.headlineNote} available={s.available} />)}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">The seven kinds of STEM work</span>
        <h2>STEM is not one thing</h2>
        <p class="lede">
          A civil engineer and a cybersecurity analyst both count as STEM, and
          they do very different work. Here is how we split them up.
        </p>
      </div>

      <div class="grid grid--3">
        {
          CATEGORIES.map((c) => (
            <article class="card card--flat" style={`--accent:${c.color}`}>
              <div class="cat__icon" aria-hidden="true">
                {c.icon}
              </div>
              <h3 class="card__title">{c.label}</h3>
              <p class="muted">{c.blurb}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">How this site works</span>
        <h2>Where do the numbers come from?</h2>
        <p class="lede">
          Nothing here is made up. Every figure comes from a US government
          agency, and we say which one and when.
        </p>
      </div>
      <div class="grid grid--3">
        <article class="card card--flat">
          <h3 class="card__title">📊 How many jobs, and what they pay</h3>
          <p class="muted">
            Once a year the Bureau of Labor Statistics asks every employer in
            the country how many people they employ and what they pay. That
            survey is where the job counts and the salaries come from.
          </p>
        </article>
        <article class="card card--flat">
          <h3 class="card__title">📣 What is open right now</h3>
          <p class="muted">
            Job boards publish every opening as it appears. We ask each one
            about every STEM job we track, so the counts are exact rather than
            a guess from the job title.
          </p>
        </article>
        <article class="card card--flat">
          <h3 class="card__title">🧭 What to study next</h3>
          <p class="muted">
            The Bureau of Labor Statistics also records what education people
            usually need to get into each job. We put that on every career
            page, next to a plain-English description of the work.
          </p>
        </article>
      </div>
      <p class="source-note">
        Want the details? <a href={withBase("/sources")}>See every source and how we use it.</a>
        · <a href={withBase("/glossary")}>Not sure what a word means? Try the glossary.</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .cat__icon {
    font-size: 1.75rem;
    line-height: 1;
    margin-bottom: var(--space-2xs);
  }
</style>
