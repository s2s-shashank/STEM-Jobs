# Copy this file to .env and fill in the values.
# .env is never committed - it only lives on your machine and in the
# repository secrets on GitHub.

# USAJOBS API key (https://developer.usajobs.gov/api-token/)
USAJOBS_API_KEY=

# Contact email sent in the User-Agent header (required by USAJOBS + BLS).
# Replace with your real email so agencies can reach you if you abuse a quota.
BLS_CONTACT_EMAIL=

# CareerOneStop (https://api.careeronestop.org/)
CAREERONESTOP_USER_ID=
CAREERONESTOP_TOKEN=
